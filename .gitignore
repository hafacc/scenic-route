# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# sveltekit
/.svelte-kit/
/out/

# local agent notes and agent worktrees
/AGENTS.md
/CLAUDE.md
/.claude/

# map overlays, rendered from data/streets/*.bin by `bun run build-tiles`
/public/tiles/
/public/streets/
/public/casters/
/public/commercial/
/public/commercial-lines/
/public/shade/
/public/routing/
/public/trees/
/public/landmarks/
/public/art/
/public/legacy/
/public/ferries/
/public/subway/
/public/highways/
/public/dining/
/public/openstreets/
/public/landuse/
/public/industrial/
/public/historic/
# Not public/sheds/, ferry-schedule/ or transit-schedule/: a daily job commits them and the client reads them off `main` (raw.githubusercontent.com); never LFS-track them (data/README.md).
# public/ferries/ above is different: the deploy's own drawn ferry lines.
# Nor public/icons/ or public/sw.js: hand-made static assets.

# Overture places from `bun run update-places`, re-read from the pinned release rather than committed
/data/places/

# raw source reads cached by `bun run build-tree-data`; --refresh to go back to the network
/.cache/

# glue between the steps of `bun run build-tiles`, which can't name a machine temp dir
/.build/

# rust build output; crates/tiler is compiled by `bun run build-tiles`
/target

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# firebase-admin service account key (used by scripts/set-admin.ts)
service-account.json

# firebase CLI config (kept local; not part of the repo)
.firebaserc
firebase.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# throwaway analysis harnesses (belong in the session scratchpad, never the repo)
/scratchpad/
